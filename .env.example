# ─────────────────────────────────────────────────────────────────────────────
# CampaignCanvas — Environment Variables Template
#
# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk OAuth Credentials ──────────────────────────────────────────────────
# Obtain these from your Clerk Dashboard → API Keys
CLERK_CLIENT_ID=your-clerk-client-id
CLERK_CLIENT_SECRET=your-clerk-client-secret
CLERK_DOMAIN=your-app.clerk.accounts.dev
CLERK_REDIRECT_URI=http://localhost:8501/
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ── Debug / Development Flags ────────────────────────────────────────────────
# Set to "true" to allow the mock login bypass on the auth page.
# Must be "false" (or absent) in any production / staging deployment.
DEBUG_MODE=false
